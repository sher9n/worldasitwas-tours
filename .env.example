# Copy to .env and fill in. Never commit .env.
FAL_KEY=
OPENAI_API_KEY=
# Comma-separated platform keys accepted on Authorization: Bearer. Leave empty in
# dev to allow all. MUST be set in production, or the catalogue is open to anyone.
PLATFORM_KEYS=

# Secret for player tokens. The hosted player runs in a browser and must never
# hold a platform key, so a player URL carries a short-lived token instead,
# signed with this and valid for one tour and one traveller. Whoever builds
# player URLs (the app's own backend) needs the same value.
#   PLAYER_TOKEN_SECRET=$(openssl rand -base64 32)
PLAYER_TOKEN_SECRET=
PORT=4100
PUBLIC_BASE_URL=http://localhost:4100
CONTENT_DIR=./content

# Where media is actually served from. Defaults to PUBLIC_BASE_URL/media, which
# is right for local work and a single box. Point it at a bucket or CDN in
# production: manifests are re-pointed as they are read, so a walk published on
# a laptop serves correctly from anywhere without being republished.
# MEDIA_BASE_URL=https://media.worldasitwas.com

# The built player is found automatically at apps/playground/dist once `npm run
# build` has produced it, and served at the root so a walk opens at
# <origin>/?tour=...&play=1. Set this only to override the path, or to an empty
# value to serve the API without a player.
# PLAYER_DIR=
# Unauthenticated helper routes the playground console uses (the per-tour cost
# ledger). Keep this on locally; never set it on a public deployment.
ENABLE_DEV_ROUTES=1

# mock | fal   (mock writes placeholder media so the whole pipeline can run without spending)
MEDIA_PROVIDER=fal
# draft | final  (draft = 480p video, low-quality images, 1K edits)
QUALITY=draft
