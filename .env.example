# Copy to .env and fill in. Never commit .env.
FAL_KEY=
OPENAI_API_KEY=
# Comma-separated platform keys accepted on Authorization: Bearer. Leave empty in dev to allow all.
PLATFORM_KEYS=
PORT=4100
PUBLIC_BASE_URL=http://localhost:4100
CONTENT_DIR=./content
# mock | fal   (mock writes placeholder media so the whole pipeline can run without spending)
MEDIA_PROVIDER=fal
# draft | final  (draft = 480p video, low-quality images, 1K edits)
QUALITY=draft
